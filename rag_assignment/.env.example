# Copy to .env and fill in local values. Never commit .env.
# ADMIN login: used ONLY by bootstrap.py, ingest.py and the admin side of test_security.py
# (schema owner / ingestion / membership changes). Never give this to end users.
ADMIN_DATABASE_URL=postgresql://<admin_user>:<admin_password>@127.0.0.1:5434/raglab

# Restricted retrieval login: NOSUPERUSER, NOBYPASSRLS, SELECT on chunks/documents only.
# Held by the trusted backend (search.py stands in for it), never by end users.
READER_ROLE=k8s_rag_reader
READER_PASSWORD=<choose_a_local_password>

EMBED_MODEL=BAAI/bge-small-en-v1.5

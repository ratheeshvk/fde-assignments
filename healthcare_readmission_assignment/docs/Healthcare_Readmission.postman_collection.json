            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FOLLOW_UP_SCHEDULED\",\n  \"notes\": \"Follow-up appointment scheduled\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/interventions/{{queued_encounter_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "interventions",
                "{{queued_encounter_id}}"
              ]
            },
            "description": "Moves the intervention to FOLLOW_UP_SCHEDULED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Follow-up is scheduled', () => pm.expect(pm.response.json().status).to.eql('FOLLOW_UP_SCHEDULED'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

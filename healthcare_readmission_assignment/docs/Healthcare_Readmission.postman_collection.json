              ],
              "path": [
                "interventions",
                "{{queued_encounter_id}}"
              ]
            },
            "description": "Closes the intervention."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Intervention is closed', () => pm.expect(pm.response.json().status).to.eql('CLOSED'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
